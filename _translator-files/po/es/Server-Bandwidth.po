#~ msgstr "Duración buffer audio: 2,67 ms, 5,33 ms, 10,67 ms, 21,33 ms"

#~ msgid "With the following units"
#~ msgstr "Con las siguientes unidades"

#~ msgid "ms : milliseconds"
#~ msgstr "ms : milisegundos"

